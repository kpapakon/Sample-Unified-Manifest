            "resourceSpecific": [
                {
                    "name": "Document.ReadWrite.User",
                    "type": "Delegated"
                }
            ]
        }
    },
    "extensions": [
        {
            "requirements": {
                "capabilities": [
                    {
                        "name": "SharedRuntime",
                        "minVersion": "1.1"
                    }
                ],
                "scopes": [
                    "document"
                ]
            },
            "runtimes": [
                {
                    "requirements": {
                        "capabilities": [
                            {
                                "name": "AddinCommands",
                                "minVersion": "1.1"
                            }
                        ],
                        "formFactors": [
                            "desktop"
                        ]
                    },
                    "id": "runtime_1",
                    "type": "general",
                    "code": {
                        "page": "https://localhost:3000/taskpane"
                    },
                    "lifetime": "long"
                },
                {
                    "requirements": {
                        "capabilities": [
                            {
                                "name": "AddinCommands",
                                "minVersion": "1.1"
                            }
                        ],
                        "formFactors": [
                            "desktop"
                        ]
                    },
                    "id": "runtime_2",
                    "type": "general",
                    "code": {
                        "page": "https://localhost:3000/taskpane"
                    },
                    "lifetime": "short",
                    "actions": [
                        {
                            "id": "ButtonId1_1",
                            "type": "openPage",
                            "displayName": "ButtonId1_1",
                            "pinnable": false,
                            "view": "ButtonId1",
                            "multiselect": false,
                            "supportsNoItemContext": false
                        },
                        {
                            "id": "helloAction",
                            "type": "executeFunction",
                            "displayName": "helloAction",
                            "multiselect": false,
                            "supportsNoItemContext": false
                        },
                        {
                            "id": "underlinedAction",
                            "type": "executeFunction",
                            "displayName": "underlinedAction",
                            "multiselect": false,
                            "supportsNoItemContext": false
                        }
                    ]
                }
            ],
            "ribbons": [
                {
                    "requirements": {
                        "capabilities": [
                            {
                                "name": "AddinCommands",
                                "minVersion": "1.1"
                            }
