                                            "icons": [
                                                {
                                                    "size": 16,
                                                    "url": "https://localhost:3000/assets/icon-16.png"
                                                },
                                                {
                                                    "size": 32,
                                                    "url": "https://localhost:3000/assets/icon-32.png"
                                                },
                                                {
                                                    "size": 80,
                                                    "url": "https://localhost:3000/assets/icon-80.png"
                                                }
                                            ],
                                            "supertip": {
                                                "title": "Say Hello",
                                                "description": "Just do it!"
                                            },
                                            "actionId": "helloAction",
                                            "overriddenByRibbonApi": false,
                                            "enabled": true
                                        },
                                        {
                                            "id": "UnderlineButton",
                                            "type": "button",
                                            "label": "Underline",
                                            "icons": [
                                                {
                                                    "size": 16,
                                                    "url": "https://localhost:3000/assets/icon-16.png"
                                                },
                                                {
                                                    "size": 32,
                                                    "url": "https://localhost:3000/assets/icon-32.png"
                                                },
                                                {
                                                    "size": 80,
                                                    "url": "https://localhost:3000/assets/icon-80.png"
                                                }
                                            ],
                                            "supertip": {
                                                "title": "Underline",
                                                "description": "Underline selection"
                                            },
                                            "actionId": "underlinedAction",
                                            "overriddenByRibbonApi": false,
                                            "enabled": false
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ],
            "alternates": [
                {
                    "alternateIcons": {
                        "icon": {
                            "size": 32,
                            "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        "highResolutionIcon": {
                            "size": 64,
                            "url": "https://localhost:3000/assets/icon-64.png"
                        }
                    }
                }
            ]
        }
    ]
